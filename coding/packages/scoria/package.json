{
  "name": "scoria",
  "version": "0.0.1",
  "description": "Code quality assay harness for TypeScript and JavaScript",
  "license": "MIT",
  "author": "isamu",
  "type": "module",
  "bin": {
    "scoria": "./bin/scoria.js"
  },
  "exports": {
