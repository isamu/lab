{
  "name": "scoria",
  "version": "0.3.0",
  "description": "Code quality assay harness for TypeScript and JavaScript",
  "license": "MIT",
  "author": "isamu",
  "type": "module",
  "bin": {
    "scoria": "bin/scoria.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "types": "./src/plugin.ts",
      "import": "./dist/plugin.js"
    }
  },
  "files": [
    "dist",
    "src",
    "rubrics",
    "bin",
    "README.ja.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "jscpd": "^4.0.5",
    "knip": "^6.35.1",
    "madge": "^8.0.0",
    "oxlint": "^1.82.0",
    "yaml": "^2.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isamu/lab.git",
    "directory": "coding/packages/scoria"
  },
  "homepage": "https://github.com/isamu/lab/tree/main/coding/packages/scoria#readme",
  "bugs": {
    "url": "https://github.com/isamu/lab/issues"
  },
  "keywords": [
    "code-quality",
    "static-analysis",
    "typescript",
    "vue",
    "react",
    "ci",
    "sarif",
    "lint"
  ]
}
