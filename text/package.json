{
  "name": "chaff-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "corpus": "node scripts/corpus-run.ts",
    "corpus:fetch": "node scripts/corpus-fetch.ts",
    "corpus:health": "node scripts/corpus-health.ts",
    "rules:measure": "node scripts/rules-measure.ts",
    "bench": "node scripts/bench.ts",
    "contracts": "node scripts/planted.ts contracts",
    "planted": "node scripts/planted.ts",
    "bench:ai": "node scripts/ai-bench.ts",
    "ai-score:corpus": "node scripts/ai-score-corpus.ts",
    "build": "yarn workspace @chaffjs/lang-ja build && yarn workspace @chaffjs/lang-en build && yarn workspace chaffjs build",
    "duplication": "npx --yes jscpd@4 . --format typescript,javascript --ignore \"**/node_modules/**,**/dist/**,**/*.d.ts\" --reporters console",
    "example": "node packages/chaff/bin/chaff.js examples/ --compact",
    "example:friendly": "node packages/chaff/bin/chaff.js examples/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "lint": "eslint .",
    "screens:update": "node scripts/guide-screens.ts --update",
    "lint:oxlint": "npx --yes oxlint@1.82.0 -D correctness packages/",
    "test": "node scripts/test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "character-entities": "^2.0.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-sonarjs": "^4.2.0",
    "fast-xml-parser": "^5.11.1",
    "globals": "^17.9.0",
    "knip": "^6.32.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
