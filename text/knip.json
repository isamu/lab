{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["test/test_*.ts"],
      "project": ["test/**/*.ts"]
    },
    "packages/chaff": {
      "entry": ["src/detectors/registry/*.ts", "src/browser/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/lang-ja": {
      "entry": ["src/browser/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/lang-en": {
      "entry": ["src/browser/*.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  "rules": {
    "exports": "warn",
    "types": "warn",
    "files": "warn",
    "dependencies": "warn",
    "devDependencies": "warn",
    "unlisted": "warn",
    "binaries": "warn"
  }
}
