{
  "name": "chaffjs",
  "version": "0.28.0",
  "description": "Prose validation harness. Finds what is hard to read, and never rewrites it for you.",
  "keywords": [
    "chaff",
    "lint",
    "prose",
    "writing",
    "textlint",
    "style-guide",
    "japanese",
    "ci"
  ],
  "homepage": "https://github.com/isamu/lab/tree/main/text",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isamu/lab.git",
    "directory": "text/packages/chaff"
  },
  "license": "MIT",
  "author": "isamu",
  "type": "module",
  "bin": {
    "chaffjs": "./bin/chaff.js",
    "chaff": "./bin/chaff.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "types": "./src/plugin.ts",
      "import": "./dist/plugin.js"
    },
    "./api": {
      "types": "./src/api.ts",
      "import": "./dist/api.js"
    },
    "./grade": {
      "types": "./src/grade-api.ts",
      "import": "./dist/grade-api.js"
    },
    "./browser": {
      "types": "./src/browser.ts",
      "import": "./dist/browser.js"
    },
    "./browser-files": {
      "types": "./src/browser-files.ts",
      "import": "./dist/browser-files.js"
    }
  },
  "browser": {
    "./src/package-files.ts": "./src/browser/package-files.ts",
    "./src/adapter-import.ts": "./src/browser/adapter-import.ts",
    "./src/detectors/index.ts": "./src/browser/detectors.ts",
    "./src/custom/bounded-match.ts": "./src/browser/bounded-match.ts",
    "./src/config/working-dir.ts": "./src/browser/working-dir.ts",
    "./dist/package-files.js": "./dist/browser/package-files.js",
    "./dist/adapter-import.js": "./dist/browser/adapter-import.js",
    "./dist/detectors/index.js": "./dist/browser/detectors.js",
    "./dist/custom/bounded-match.js": "./dist/browser/bounded-match.js",
    "./dist/config/working-dir.js": "./dist/browser/working-dir.js",
    "node:path": "./dist/browser/path.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "bin",
    "dist",
    "genres.yaml",
    "profiles",
    "reference-headings.yaml",
    "structure-baseline.yaml",
    "rules",
    "skills",
    "styles",
    "src"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@chaffjs/lang-en": "0.25.0",
    "@chaffjs/lang-ja": "0.27.0",
    "character-entities": "^2.0.2",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm-table": "^2.0.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm-table": "^2.1.1",
    "openai": "^7.15.0",
    "yaml": "^2.9.0"
  }
}
