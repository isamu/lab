{
  "name": "chaffjs",
  "version": "0.5.0",
  "description": "Prose validation harness. Finds what is hard to read, and never rewrites it for you.",
  "keywords": [
    "chaff",
    "lint",
    "prose",
    "writing",
    "textlint",
    "style-guide",
    "japanese",
    "ci"
  ],
  "homepage": "https://github.com/isamu/lab/tree/main/text",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isamu/lab.git",
    "directory": "text/packages/chaff"
  },
  "license": "MIT",
  "author": "isamu",
  "type": "module",
  "bin": {
    "chaffjs": "./bin/chaff.js",
    "chaff": "./bin/chaff.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "types": "./src/plugin.ts",
      "import": "./dist/plugin.js"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "bin",
    "dist",
    "rules",
    "src"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@chaffjs/lang-en": "0.5.0",
    "@chaffjs/lang-ja": "0.5.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm-table": "^2.0.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm-table": "^2.1.1",
    "openai": "^7.15.0",
    "yaml": "^2.9.0"
  }
}
