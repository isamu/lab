{
  "name": "chaff-site",
  "private": true,
  "type": "module",
  "scripts": {
    "examples": "node ../scripts/rule-examples.ts src/generated/rule-examples.json",
    "dev": "yarn examples && astro dev",
    "build": "yarn examples && astro build",
    "preview": "astro preview",
    "docs:links": "node ../scripts/docs-links.ts dist",
    "typecheck": "yarn examples && astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3"
  }
}
