---
import Base from "../../../layouts/Base.astro";
import Badge from "../../../components/Badge.astro";
import { LANGS, href, isLang, t } from "../../../lib/i18n";
import { rules } from "../../../lib/rules";

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));

const { lang } = Astro.params;
if (!isLang(lang)) throw new Error(`unknown language ${String(lang)}`);
const layers = [...new Set(rules.map((rule) => rule.layer))];
---

<Base lang={lang} title={t(lang, "rules")} path="rules">
  <h1 class="text-3xl font-bold">{t(lang, "rules")}</h1>
  <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">{t(lang, "experimentalNote")}</p>
  {layers.map((layer) => (
    <section class="mt-8">
      <h2 class="font-mono text-xl font-semibold">{layer}</h2>
      <ul class="mt-3 divide-y divide-zinc-200 dark:divide-zinc-800">
        {rules
          .filter((rule) => rule.layer === layer)
          .map((rule) => (
            <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 py-2">
              <a href={href(`${lang}/rules/${rule.id}`)} class="font-mono text-sm text-blue-700 underline dark:text-blue-400">
                {rule.id}
              </a>
              <span>{rule.name[lang]}</span>
              {rule.status === "experimental" && <Badge tone="warn">{t(lang, "experimental")}</Badge>}
              {rule.languages.length === 1 && <Badge tone="neutral">{rule.languages[0]}</Badge>}
            </li>
          ))}
      </ul>
    </section>
  ))}
</Base>
