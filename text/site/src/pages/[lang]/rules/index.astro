---
import Base from "../../../layouts/Base.astro";
import Badge from "../../../components/Badge.astro";
import { LANGS, groupText, href, isLang, t } from "../../../lib/i18n";
import { catalogOf } from "../../../lib/ruleCatalog";

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));

const { lang } = Astro.params;
if (!isLang(lang)) throw new Error(`unknown language ${String(lang)}`);
const groups = catalogOf(lang);
const RUNS_WHEN = {
  default: "runsDefault",
  info: "runsInfo",
  experimental: "runsExperimental",
  style: "runsStyle",
  team: "runsTeam",
  test: "runsTest",
} as const;
---

<Base lang={lang} title={t(lang, "rules")} path="rules">
  <h1 class="text-3xl font-bold">{t(lang, "rules")}</h1>
  <p class="mt-2 leading-relaxed">{t(lang, "rulesIntro")}</p>
  <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">{t(lang, "experimentalNote")}</p>
  <p class="mt-2 text-sm">
    <a href={href(`${lang}/guide/reference`)} class="text-blue-700 underline dark:text-blue-400">
      {t(lang, "referenceLink")}
    </a>
  </p>
  <nav class="mt-6 text-sm">
    <div class="text-zinc-500">{t(lang, "refContents")}</div>
    <div class="mt-1 flex flex-wrap gap-x-4 gap-y-1">
      {groups.map(({ group, entries }) => (
        <a href={`#${group}`} class="text-blue-700 underline dark:text-blue-400">
          {groupText(lang, group).name} ({entries.length})
        </a>
      ))}
    </div>
  </nav>
  {groups.map(({ group, entries }) => (
    <section class="mt-8">
      <h2 id={group} class="text-xl font-semibold">
        {groupText(lang, group).name}
      </h2>
      <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">{groupText(lang, group).note}</p>
      <ul class="mt-3 divide-y divide-zinc-200 dark:divide-zinc-800">
        {entries.map(({ rule, runsWhen, teaser }) => (
          <li class="py-3">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <a href={href(`${lang}/rules/${rule.id}`)} class="text-blue-700 underline dark:text-blue-400">
                {rule.name[lang]}
              </a>
              <span class="font-mono text-xs text-zinc-500">{rule.id}</span>
              {runsWhen !== "default" && <Badge tone={runsWhen === "info" ? "neutral" : "warn"}>{t(lang, RUNS_WHEN[runsWhen])}</Badge>}
              {rule.languages.length === 1 && <Badge tone="neutral">{rule.languages[0]}</Badge>}
            </div>
            <div class="mt-1">{rule.summary[lang]}</div>
            {teaser.text !== "" && (
              <div class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">
                <span class="text-xs text-zinc-500">{t(lang, teaser.kind === "message" ? "teaserMessage" : "teaserExcerpt")}:</span>{" "}
                <span class="rounded bg-zinc-100 px-1 font-mono text-xs dark:bg-zinc-900">{teaser.text}</span>
              </div>
            )}
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
