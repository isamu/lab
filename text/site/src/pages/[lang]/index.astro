---
import Base from "../../layouts/Base.astro";
import { LANGS, href, isLang, t } from "../../lib/i18n";
import { rules } from "../../lib/rules";
import { guidePages } from "../../lib/guide";

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));

const { lang } = Astro.params;
if (!isLang(lang)) throw new Error(`unknown language ${String(lang)}`);
const firstGuidePage = (await guidePages(lang))[0];
---

<Base lang={lang} title={t(lang, "siteTitle")} path="">
  <h1 class="font-mono text-4xl font-bold">{t(lang, "siteTitle")}</h1>
  <p class="mt-3 text-lg text-zinc-600 dark:text-zinc-400">{t(lang, "tagline")}</p>
  <pre class="mt-6 overflow-x-auto rounded bg-zinc-100 p-4 font-mono text-sm dark:bg-zinc-900">{`npx chaffjs article.md
npx chaffjs --genre legal/contract ${lang === "ja" ? "契約書.md" : "contract.md"}`}</pre>
  <p class="mt-3">
    <a href={href(`${lang}/genres`)} class="text-blue-700 underline dark:text-blue-400">
      {t(lang, "pickGenre")}
    </a>
  </p>
  {firstGuidePage && (
    <p class="mt-8">
      <a
        href={href(`${lang}/guide/${firstGuidePage.slug}`)}
        class="rounded bg-zinc-900 px-3 py-2 text-white hover:bg-zinc-700 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-zinc-300"
      >
        {t(lang, "startGuide")}
      </a>
    </p>
  )}
  <p class="mt-6">
    <a href={href(`${lang}/rules`)} class="text-blue-700 underline dark:text-blue-400">
      {rules.length} {t(lang, "ruleCount")}
    </a>
  </p>
</Base>
