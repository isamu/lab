---
import "../styles/global.css";
import { href, otherLang, t, type Lang } from "../lib/i18n";
import { guidePages } from "../lib/guide";

// `otherPath` is where the language switch goes: the same page in the other language, or its home when there is none.
// `documentTitle` replaces the whole <title> where the page name alone would say too little (the home page).
type Props = { lang: Lang; title: string; path: string; otherPath?: string; description?: string; documentTitle?: string };
const { lang, title, path, otherPath = path, description, documentTitle } = Astro.props;
const other = otherLang(lang);
const firstGuidePage = (await guidePages(lang))[0];
const pageTitle = documentTitle ?? (title === t(lang, "siteTitle") ? title : `${title} | ${t(lang, "siteTitle")}`);
const pageDescription = description ?? t(lang, "tagline");
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const OG_LOCALE: Record<Lang, string> = { ja: "ja_JP", en: "en_US" };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="8MAfhFhSHnIJqDtwfiEIIs4pkIkk0EMHgN_3p0zVMrg" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={other} href={new URL(href(`${other}/${otherPath}`), Astro.site).href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t(lang, "siteTitle")} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
  </head>
  <body class="min-h-screen bg-white text-zinc-900 antialiased dark:bg-zinc-950 dark:text-zinc-100">
    <header class="border-b border-zinc-200 dark:border-zinc-800">
      <nav class="mx-auto flex max-w-4xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3">
        <a href={href(lang)} class="font-mono text-lg font-bold tracking-tight">
          {t(lang, "siteTitle")}
        </a>
        {firstGuidePage && (
          <a
            href={href(`${lang}/guide/${firstGuidePage.slug}`)}
            class="text-sm text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
          >
            {t(lang, "guide")}
          </a>
        )}
        <a href={href(`${lang}/genres`)} class="text-sm text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100">
          {t(lang, "genres")}
        </a>
        <a href={href(`${lang}/rules`)} class="text-sm text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100">
          {t(lang, "rules")}
        </a>
        <a href={href(`${lang}/playground`)} class="text-sm text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100">
          {t(lang, "playground")}
        </a>
        <a
          href={href(`${other}/${otherPath}`)}
          hreflang={other}
          class="ml-auto rounded border border-zinc-300 px-2 py-1 text-sm hover:bg-zinc-100 dark:border-zinc-700 dark:hover:bg-zinc-900"
        >
          {t(lang, "switchTo")}
        </a>
      </nav>
    </header>
    <main class="mx-auto max-w-4xl px-4 py-8">
      <slot />
    </main>
  </body>
</html>
